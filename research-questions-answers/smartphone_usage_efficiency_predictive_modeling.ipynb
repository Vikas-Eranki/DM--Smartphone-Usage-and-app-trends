      "source": [
        "4. Create Efficiency Score + Label Users\n",
        "\n",
        "Description:\n",
        "\n",
        "Creates an efficiency metric.\n",
        "Labels users into 3 categories (efficient, inefficient, neutral).\n",
        "Drops neutral for clean binary prediction."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 29,
      "id": "200561b3",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 178
        },
        "id": "200561b3",
        "outputId": "1c240ff6-ab94-45e2-ea04-313804e37c4e"
      },
      "outputs": [
        {
          "data": {
            "text/plain": [
              "y\n",
              "0    330\n",
              "1    330\n",
              "Name: count, dtype: int64"
            ]
          },
          "execution_count": 29,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "df[\"efficiency_score\"] = (\n",
        "    df[\"Productivity_App_Usage_Hours\"] /\n",
        "    df[\"Daily_Screen_Time_Hours\"].replace(0, np.nan)\n",
        ").fillna(0)\n",
        "\n",
        "low = df[\"efficiency_score\"].quantile(0.33)\n",
        "high = df[\"efficiency_score\"].quantile(0.67)\n",
        "\n",
        "def label_user(x):\n",
        "    if x <= low:\n",
        "        return 0  # inefficient\n",
        "    elif x >= high:\n",
        "        return 1  # efficient\n",
        "    else:\n",
        "        return 2  # neutral\n",
        "\n",
        "df[\"label\"] = df[\"efficiency_score\"].apply(label_user)\n",
        "\n",
        "df2 = df[df[\"label\"] != 2].copy()\n",
        "df2[\"y\"] = df2[\"label\"]\n",
        "\n",
        "df2[\"y\"].value_counts()\n"
      ]
    },
