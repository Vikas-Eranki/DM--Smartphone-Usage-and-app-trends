      "source": [
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(\"/Users/meenakshsinghania04/Desktop/DM--Smartphone-Usage-and-app-trends/data/processed/mobile_usage_behavioral_analysis_cleaned.csv\")  # change path if needed\n",
        "\n",
        "screen_time = df[\"Daily_Screen_Time_Hours\"]\n",
        "\n",
        "# =========================\n",
        "# 3. Boxplot BEFORE removing outliers\n",
        "# =========================\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.boxplot(screen_time.dropna())\n",
        "plt.title(\"Daily Screen Time (Hours) - BEFORE Removing Outliers\")\n",
        "plt.ylabel(\"Hours\")\n",
        "plt.show()\n",
        "\n",
        "# =========================\n",
        "# 4. Remove outliers using IQR method\n",
        "# =========================\n",
        "Q1 = screen_time.quantile(0.25)\n",
        "Q3 = screen_time.quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "lower_bound = Q1 - 1.5 * IQR\n",
        "upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "screen_time_no_outliers = screen_time[\n",
        "    (screen_time >= lower_bound) & (screen_time <= upper_bound)\n",
        "]\n",
        "\n",
        "print(\"Lower bound:\", lower_bound)\n",
        "print(\"Upper bound:\", upper_bound)\n",
        "print(\"Original count:\", len(screen_time))\n",
        "print(\"After removing outliers:\", len(screen_time_no_outliers))\n",
        "\n",
        "# =========================\n",
        "# 5. Boxplot AFTER removing outliers\n",
        "# =========================\n",
        "plt.figure(figsize=(8, 5))\n",
        "plt.boxplot(screen_time_no_outliers.dropna())\n",
        "plt.title(\"Daily Screen Time (Hours) - AFTER Removing Outliers (IQR Method)\")\n",
        "plt.ylabel(\"Hours\")\n",
        "plt.show()\n"
      ]
    },
